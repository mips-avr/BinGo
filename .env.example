# ==============================================
# BinGo — Contoh variabel lingkungan (Phase 1)
# Salin ke .env (root) lalu sesuaikan nilainya.
# ==============================================

# ---- Database (Postgres + PostGIS lokal via docker-compose) ----
POSTGRES_USER=bingo
POSTGRES_PASSWORD=bingo_dev_password
POSTGRES_DB=bingo
POSTGRES_PORT=5432

# DATABASE_URL dipakai oleh Prisma di apps/backend
DATABASE_URL="postgresql://bingo:bingo_dev_password@localhost:5432/bingo?schema=public"

# ---- Backend (NestJS) ----
BACKEND_PORT=3000
NODE_ENV=development
# WAJIB diisi saat NODE_ENV=production — backend menolak boot tanpanya, dan
# juga menolak boot bila nilainya masih secret bawaan pengembangan.
# Buat nilainya dengan: openssl rand -base64 48
JWT_SECRET=ganti_dengan_secret_acak_panjang_minimal_32_karakter
JWT_EXPIRES_IN=7d
PUBLIC_BASE_URL=http://localhost:3000
# Production Vercel only; otomatis dibuat saat Blob store dihubungkan.
BLOB_READ_WRITE_TOKEN=

# ---- Mobile (Expo) ----
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
