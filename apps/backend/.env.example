# Salin ke apps/backend/.env saat menjalankan secara lokal.
NODE_ENV=development
BACKEND_PORT=3000
DATABASE_URL="postgresql://bingo:bingo_dev_password@localhost:5432/bingo?schema=public"
# WAJIB diisi saat NODE_ENV=production — aplikasi menolak boot tanpanya, dan
# juga menolak boot bila nilainya masih secret bawaan pengembangan. Di mode
# development boleh dikosongkan; aplikasi memakai nilai bawaan sambil mencetak
# peringatan. Buat nilainya dengan: openssl rand -base64 48
JWT_SECRET=ganti_dengan_secret_acak_panjang_minimal_32_karakter
JWT_EXPIRES_IN=7d
