# Salin ke apps/backend/.env saat menjalankan secara lokal.
NODE_ENV=development
BACKEND_PORT=3000
DATABASE_URL="postgresql://bingo:bingo_dev_password@localhost:5432/bingo?schema=public"
# WAJIB diisi saat NODE_ENV=production — aplikasi menolak boot tanpanya, dan
# juga menolak boot bila nilainya masih secret bawaan pengembangan. Di mode
# development boleh dikosongkan; aplikasi memakai nilai bawaan sambil mencetak
# peringatan. Buat nilainya dengan: openssl rand -base64 48
JWT_SECRET=ganti_dengan_secret_acak_panjang_minimal_32_karakter
JWT_EXPIRES_IN=7d
# Production URL backend, tanpa trailing slash.
PUBLIC_BASE_URL=https://bingo-api.example.com
# Diisi otomatis ketika Vercel Blob dihubungkan ke project.
BLOB_READ_WRITE_TOKEN=

# ---- Produksi (Vercel + Neon) ----
# DATABASE_URL memakai connection string Neon yang ber-"-pooler".
# DIRECT_URL memakai yang TANPA "-pooler"; dipakai Prisma Migrate.
DIRECT_URL=

# Daftar origin web yang boleh memanggil API, dipisah koma, tanpa garis miring
# di akhir. Dikosongkan = origin mana pun dipantulkan (hanya untuk lokal).
CORS_ORIGINS=

# Wajib di Vercel: sistem berkas serverless tidak permanen, jadi unggahan
# disimpan di Vercel Blob.
BLOB_READ_WRITE_TOKEN=
