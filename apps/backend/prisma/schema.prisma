/// Jenis lembaga yang boleh menjamin seorang pemulung.
///
/// Daftar ini bukan pilihan gaya. BinGo tidak mengumpulkan NIK karena akses
/// data kependudukan diatur Permendagri 102/2019 dan tertutup bagi tim ini,
/// sehingga NIK yang tersimpan tidak akan pernah dapat dicocokkan ke sumber
/// resmi mana pun. Penggantinya adalah pihak yang benar-benar mengenal pemulung
/// di lapangan: penerima material dan pengurus lingkungan.
enum AttestorType {
  BANK_SAMPAH
  LAPAK
  TPS3R
  KSM_PERSAMPAHAN
  RT_RW
}

enum AgentVerificationStatus {
  MENUNGGU
  DISETUJUI
  DITOLAK
  DICABUT
}

/// Satu langkah pada jejak audit penjaminan.
enum AgentVerificationAction {
  DIAJUKAN
  DISETUJUI
  DITOLAK
  DICABUT
}

enum TransactionStatus {
  PENDING
  PAID
  SHIPPED
  COMPLETED
  CANCELLED
}

enum MaterialType {
  PET
  HDPE
  PVC
  LDPE
  PP
  PS
  OTHER_PLASTIC
  PAPER
  METAL
  GLASS
  ORGANIC
  MIXED
}

enum CollectionSchedulePublisherType {
  DLH
  SUDIN_LH
  KELURAHAN_RT_RW
  BANK_SAMPAH
  TPS3R
  OPERATOR
}

enum CollectionServiceMode {
  DOOR_TO_DOOR
